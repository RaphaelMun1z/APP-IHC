{
  "name": "ipb-app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0"
  },
  "scripts": {
    "dev": "ng serve --host 127.0.0.1 --port 4173",
    "start": "npm run dev",
    "build": "ng build",
    "build:github-pages": "ng build --configuration production --base-href /APP-IHC/ && node scripts/prepare-github-pages.cjs",
    "deploy:github-pages": "npm run build:github-pages",
    "preview": "node scripts/preview.cjs",
    "test": "ng test --watch=false",
    "test:contracts": "node scripts/check-api-contracts.cjs",
    "mock:transport": "postman mock generate docs/openapi.yaml --output .preview/http-mock --force --port 4011 && node scripts/prepare-http-simulation.cjs && postman simulation run postman/simulations/ipb-http.sim.yaml --port 4011 --no-history --output ndjson",
    "test:transport": "node scripts/test-http-transport.cjs",
    "test:e2e": "playwright test",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/forms": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@angular/router": "22.2.6",
    "gsap": "^3.15.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.7",
    "@angular/cli": "22.2.7",
    "@angular/compiler-cli": "22.2.6",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.15.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.8.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.62.0",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
